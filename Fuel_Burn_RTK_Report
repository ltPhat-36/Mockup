<script>
(() => {
'use strict';
const $=id=>document.getElementById(id);
const CATS=['A320','A321 CEO','A321 NEO','A350','B787','ATR'];
const METRICS=[
  {key:'rFuel',name:'Total Fuel Receipt',unit:'kg',group:'receipt'},
  {key:'rPayload',name:'Total Payload',unit:'tonnes',group:'receipt'},
  {key:'rDistance',name:'Total GND DIST',unit:'km',group:'receipt'},
  {key:'rRtk',name:'Total RTK',unit:'tonne-km',group:'receipt'},
  {key:'rRatio',name:'Fuel Burn/RTK',unit:'kg/tonne-km',group:'receipt'},
  {key:'aFuel',name:'Total TRIP FUEL ACARS',unit:'kg',group:'acars'},
  {key:'aPayload',name:'Total Payload',unit:'tonnes',group:'acars'},
  {key:'aDistance',name:'Total GND DIST',unit:'km',group:'acars'},
  {key:'aRtk',name:'Total RTK',unit:'tonne-km',group:'acars'},
  {key:'aRatio',name:'Fuel Burn/RTK',unit:'kg/tonne-km',group:'acars'}
];
const INIT={from:'2026-08-01',to:'2026-10-31',doit:'ALL',group:'both',cats:[...CATS]};
let selected=new Set(CATS), visible=new Set(METRICS.map(m=>m.key)), hasSearched=false, rows=[],page=1, applied={...INIT};
const fmtInt=new Intl.NumberFormat('en-US',{maximumFractionDigits:0});
const fmtTon=new Intl.NumberFormat('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
const fmtRatio=new Intl.NumberFormat('en-US',{minimumFractionDigits:3,maximumFractionDigits:3});
const monthFmt=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const AIRPORTS={HAN:[21.2212,105.8072],SGN:[10.8188,106.652],DAD:[16.0439,108.1994],CXR:[11.9982,109.2194],PQC:[10.1698,103.9931],BMV:[12.6683,108.120003],BKK:[13.69,100.7501],ICN:[37.4602,126.4407],SIN:[1.3644,103.9915],NRT:[35.7719,140.3929],HKG:[22.308,113.9185],KUL:[2.7456,101.7072],VTE:[17.9883,102.5633]};
const ROUTES={DO:[['HAN','SGN'],['HAN','DAD'],['SGN','CXR'],['SGN','PQC'],['HAN','BMV']],IT:[['HAN','BKK'],['HAN','ICN'],['SGN','SIN'],['SGN','NRT'],['HAN','HKG'],['SGN','KUL'],['HAN','VTE']]};
function haversine(a,b){const rad=Math.PI/180;const [la1,lo1]=AIRPORTS[a],[la2,lo2]=AIRPORTS[b];const dLa=(la2-la1)*rad,dLo=(lo2-lo1)*rad;const h=Math.sin(dLa/2)**2+Math.cos(la1*rad)*Math.cos(la2*rad)*Math.sin(dLo/2)**2;return 2*6371*Math.asin(Math.sqrt(h));}
function pseudo(v){let x=Math.sin(v*127.1+321.21)*43758.5453;return x-Math.floor(x);}
function buildRecords(){const out=[];let id=0;for(let y=2025;y<=2026;y++)for(let m=1;m<=12;m++){if(y===2026&&m>10)continue;for(const cat of CATS)for(const doit of ['DO','IT']){if(cat==='ATR'&&doit==='IT')continue;for(let k=0;k<7;k++){const dt=`${y}-${String(m).padStart(2,'0')}-${String(2+k*4).padStart(2,'0')}`;const routes=ROUTES[doit];const route=routes[Math.floor(pseudo(++id*1.1)*routes.length)];if(cat==='ATR' && !['DAD','BMV','CXR'].some(v=>route.includes(v)))continue;const dist=Math.round(haversine(...route));const base={A320:14,'A321 CEO':17,'A321 NEO':18,A350:49,B787:43,ATR:6}[cat];const payloadTon=base*(.70+pseudo(id*2.31)*.35);const fuelPerKm={A320:3.2,'A321 CEO':3.7,'A321 NEO':3.35,A350:8.3,B787:7.8,ATR:1.75}[cat];const fuel=Math.round(dist*fuelPerKm*(.90+pseudo(id*3.7)*.18)+150);out.push({date:dt,cat,doit,acarsFuel:fuel,tonnes:payloadTon,dist,rtk:dist*payloadTon});}}}return out;}
const DEMO=buildRecords();
function groupRows(filter){
  const map=new Map();
  for(const r of DEMO){
    if(r.date<filter.from||r.date>filter.to)continue;
    if(filter.doit!=='ALL'&&r.doit!==filter.doit)continue;
    if(!filter.cats.includes(r.cat))continue;
    // Month & Year: a yearly summary followed by the months belonging to that year.
    // A flight contributes once to the annual summary and once to its corresponding month.
    const year=r.date.slice(0,4), month=r.date.slice(0,7);
    const periods=filter.group==='both'?[year,month]:filter.group==='year'?[year]:[month];
    for(const period of periods){
      const key=[period,r.doit,r.cat].join('|');
      if(!map.has(key))map.set(key,{
        period,doit:r.doit,cat:r.cat,
        aFuel:0,aPayload:0,aDistance:0,aRtk:0,
        rFuel:null,rPayload:null,rDistance:null,rRtk:null,rRatio:null
      });
      const v=map.get(key);
      v.aFuel+=r.acarsFuel;
      v.aPayload+=r.tonnes;
      v.aDistance+=r.dist;
      v.aRtk+=r.rtk;
    }
  }
  return [...map.values()]
    .map(r=>({...r,aRatio:r.aRtk>0?r.aFuel/r.aRtk:null}))
    .sort((a,b)=>{
      // Latest year first; the year's summary comes before all months of that year.
      const yr=b.period.slice(0,4).localeCompare(a.period.slice(0,4));
      if(yr)return yr;
      const aYear=a.period.length===4,bYear=b.period.length===4;
      if(aYear!==bYear)return aYear?-1:1;
      const periodOrder=b.period.localeCompare(a.period);
      return periodOrder||a.doit.localeCompare(b.doit)||CATS.indexOf(a.cat)-CATS.indexOf(b.cat);
    });
}
function showPeriod(p){
  if(p.length===4)return p;
  const [y,m]=p.split('-');
  return `${monthFmt[+m-1].toUpperCase()}/${y}`;
}
function validFilters(){const f={from:$('dateFrom').value,to:$('dateTo').value,doit:$('domInt').value,group:$('groupBy').value,cats:[...selected]};if(!f.from||!f.to)return ['Please select both From Date and To Date.',null];if(f.from>f.to)return ['From Date must be earlier than or equal to To Date.',null];if(!f.cats.length)return ['Please select at least one AC Cate 2.',null];return [null,f];}
function renderChoice(){const holder=$('catChoices');holder.innerHTML='';for(const cat of CATS){const lbl=document.createElement('label');lbl.className='check-row';const cb=document.createElement('input');cb.type='checkbox';cb.value=cat;cb.checked=selected.has(cat);cb.addEventListener('change',()=>{cb.checked?selected.add(cat):selected.delete(cat);renderMultiText();});lbl.append(cb,document.createTextNode(cat));holder.appendChild(lbl);}renderMultiText();}
function renderMultiText(){const items=[...selected];$('multiText').textContent=items.length===CATS.length?'All AC Cate 2':items.length===0?'Select AC Cate 2':items.length<=2?items.join(', '):`${items.length} categories selected`;$('allCatBtn').textContent=items.length===CATS.length?'Unselect all':'Select all';}
function renderSetting(){const box=$('settingList');box.innerHTML='';for(const g of ['receipt','acars']){const title=document.createElement('div');title.className=`sg ${g}`;title.textContent=g==='receipt'?'Fuel Receipt':'ACARS';box.append(title);for(const m of METRICS.filter(m=>m.group===g)){const label=document.createElement('label');const check=document.createElement('input');check.type='checkbox';check.checked=visible.has(m.key);check.addEventListener('change',()=>{if(check.checked)visible.add(m.key);else visible.delete(m.key);if(visible.size===0){visible.add(m.key);check.checked=true;}renderTable();});label.append(check,document.createTextNode(m.name));box.append(label);}}}
function visibleMetrics(group){return METRICS.filter(m=>m.group===group&&visible.has(m.key));}
function renderHeader(){const dim=applied.group==='month'?'Month':applied.group==='year'?'Year':'Month / Year';const a=visibleMetrics('receipt'),b=visibleMetrics('acars');const fixed=[{name:dim,cls:'col-period stick1'},{name:'DO/IT',cls:'col-doit stick2'},{name:'AC Cate 2',cls:'col-ac stick3'}];$('cols').innerHTML=fixed.map(x=>`<col style="width:${x.name==='DO/IT'?'69px':x.name==='AC Cate 2'?'115px':'112px'}">`).join('')+Array.from({length:a.length+b.length},()=>'<col style="width:123px">').join('');let top='<tr>'+fixed.map(c=>`<th class="${c.cls}" rowspan="2">${c.name}</th>`).join('');if(a.length)top+=`<th colspan="${a.length}" class="group-receipt">Fuel Receipt</th>`;if(b.length)top+=`<th colspan="${b.length}" class="group-acars">ACARS</th>`;top+='</tr>';const next='<tr>'+[...a,...b].map(m=>`<th class="metric" title="${m.name} (${m.unit})">${m.name}<span class="unit">(${m.unit})</span></th>`).join('')+'</tr>';$('dataHead').innerHTML=top+next;}
function metricText(m,row){const v=row[m.key];if(v===null||v===undefined)return '<span class="dim">—</span>';let out;if(m.key==='aRatio')out=fmtRatio.format(v);else if(m.key==='aPayload')out=fmtTon.format(v);else if(m.key==='aRtk')out=fmtTon.format(v);else out=fmtInt.format(v);return out;}
function renderTable(){renderHeader();const size=+$('pageSize').value;const pages=Math.max(1,Math.ceil(rows.length/size));if(page>pages)page=pages;const current=rows.slice((page-1)*size,page*size);$('dataBody').innerHTML='';const list=[...visibleMetrics('receipt'),...visibleMetrics('acars')];let html='';for(let i=0;i<current.length;i++){const r=current[i];html+=`<tr class="${r.period.length===4?'year-summary-row':'month-data-row'}">`;if(i===0||current[i-1].period!==r.period){let n=1;while(i+n<current.length&&current[i+n].period===r.period)n++;html+=`<td class="date-cell stick1 ${r.period.length===4?'year-period':'month-period'}" rowspan="${n}">${showPeriod(r.period)}</td>`;}html+=`<td class="center stick2"><span class="${r.doit==='DO'?'dom':'int'}">${r.doit}</span></td><td class="center stick3">${r.cat}</td>`;for(const m of list){html+=`<td class="${m.key==='aRatio'?'ratio':''} ${m.key==='aRtk'?'rtk':''}">${metricText(m,r)}</td>`;}html+='</tr>';}$('dataBody').innerHTML=html;const empty=$('emptyState');empty.hidden=rows.length>0;if(rows.length===0){$('emptyTitle').textContent=hasSearched?'No matching records found':'No data to display';$('emptyDescription').innerHTML=hasSearched?'Try adjusting your filters and click <b>Search</b> again.':'Select filter criteria and click <b>Search</b> to view the report.';}$('totalRecords').textContent=`Total: ${fmtInt.format(rows.length)} records`;renderPager(pages);}
function renderPager(pages){const div=$('pager');div.innerHTML='';const add=(label,n,disabled=false,active=false)=>{const b=document.createElement('button');b.type='button';b.textContent=label;b.disabled=disabled;b.className=active?'current':'';b.addEventListener('click',()=>{page=n;renderTable();$('dataScroll').scrollTop=0;});div.append(b);};add('«',1,page===1);add('‹',page-1,page===1);const pmin=Math.max(1,Math.min(page-2,pages-4));for(let i=pmin;i<=Math.min(pages,pmin+4);i++)add(String(i),i,false,i===page);add('›',page+1,page===pages);add('»',pages,page===pages);}
function search(){const [error,f]=validFilters();$('error').textContent=error||'';if(error)return;applied=f;hasSearched=true;rows=groupRows(f);page=1;renderTable();$('dataScroll').scrollTop=0;const group=f.group==='month'?'Month':f.group==='year'?'Year':'Month & Year';$('filterNote').textContent=`${f.from} → ${f.to} · ${group} · ${f.doit==='ALL'?'DO & IT':f.doit}`;}
$('searchBtn').addEventListener('click',search);
$('resetBtn').addEventListener('click',()=>{$('dateFrom').value=INIT.from;$('dateTo').value=INIT.to;$('domInt').value=INIT.doit;$('groupBy').value=INIT.group;selected=new Set(CATS);renderChoice();rows=[];hasSearched=false;applied={...INIT};page=1;$('error').textContent='';$('filterNote').textContent='Data source: DEP_SCHED_DT · Sort newest to oldest';renderTable();});
$('pageSize').addEventListener('change',()=>{page=1;renderTable();});
$('multiBtn').addEventListener('click',()=>{$('multiPanel').classList.toggle('hidden');$('multiBtn').setAttribute('aria-expanded',String(!$('multiPanel').classList.contains('hidden')));$('settingsPanel').classList.add('hidden');});
$('allCatBtn').addEventListener('click',()=>{selected=selected.size===CATS.length?new Set():new Set(CATS);renderChoice();});
$('tableSettingBtn').addEventListener('click',()=>{const open=$('settingsPanel').classList.toggle('hidden');$('tableSettingBtn').setAttribute('aria-expanded',String(!open));$('multiPanel').classList.add('hidden');});
window.addEventListener('click',e=>{if(!$('multiRoot').contains(e.target)){$('multiPanel').classList.add('hidden');$('multiBtn').setAttribute('aria-expanded','false');}if(!$('tableSettingBtn').parentElement.contains(e.target)){$('settingsPanel').classList.add('hidden');$('tableSettingBtn').setAttribute('aria-expanded','false');}});
$('filterCollapse').addEventListener('click',()=>{const hidden=$('filterBody').classList.toggle('hidden');$('filterCollapse').textContent=hidden?'Show ▾':'Hide ▴';});
$('operationsMenu').addEventListener('click',()=>{$('operationsChildren').classList.toggle('hidden');});

// Standalone Office Open XML exporter; creates a real .xlsx without external libraries or internet access.
function esc(v){return String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;');}
function column(n){let s='';while(n){n--;s=String.fromCharCode(65+n%26)+s;n=Math.floor(n/26);}return s;}
function cell(v,col,row,style=0){const addr=column(col)+row;if(typeof v==='number'&&Number.isFinite(v))return `<c r="${addr}" s="${style}"><v>${v}</v></c>`;return `<c r="${addr}" s="${style}" t="inlineStr"><is><t>${esc(v)}</t></is></c>`;}
function sheetXml(){const lines=[];const add=(n,vals,style=0)=>lines.push(`<row r="${n}">${vals.map((v,i)=>cell(v,i+1,n,style)).join('')}</row>`);add(1,['Fuel Burn/RTK Report'],1);add(2,[`From ${applied.from} to ${applied.to}; AC Cate 2: ${applied.cats.join(', ')}; DO/IT: ${applied.doit}; Group By: ${applied.group==='both'?'Month & Year':applied.group}. DEMO DATA. FIMS pending integration.`]);add(3,['','','','Fuel Receipt','','','','','ACARS']);add(4,[applied.group==='month'?'Month':applied.group==='year'?'Year':'Month / Year','DO/IT','AC Cate 2',...METRICS.map(m=>`${m.name} (${m.unit})`)],1);rows.forEach((r,i)=>{add(i+5,[showPeriod(r.period),r.doit,r.cat,...METRICS.map(m=>r[m.key])]);});const last=rows.length+4;return `<?xml version="1.0" encoding="UTF-8"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><dimension ref="A1:M${last}"/><sheetViews><sheetView workbookViewId="0"><pane ySplit="4" topLeftCell="A5" activePane="bottomLeft" state="frozen"/></sheetView></sheetViews><cols><col min="1" max="3" width="20" customWidth="1"/><col min="4" max="13" width="25" customWidth="1"/></cols><sheetData>${lines.join('')}</sheetData><mergeCells count="4"><mergeCell ref="A1:M1"/><mergeCell ref="A2:M2"/><mergeCell ref="D3:H3"/><mergeCell ref="I3:M3"/></mergeCells></worksheet>`;}
const enc=new TextEncoder();const crcTable=(()=>{const t=[];for(let n=0;n<256;n++){let c=n;for(let k=0;k<8;k++)c=(c&1)?(0xedb88320^(c>>>1)):(c>>>1);t[n]=c>>>0;}return t;})();
